# shellcheck shell=bash

# Login shells on macOS start here after dot_setup switches to Homebrew bash.
# brew is a slow Ruby subprocess; resolve the binary without invoking it
# (`brew --prefix` just to find `brew` itself doubles the cost for nothing),
# then call shellenv exactly once - it exports HOMEBREW_PREFIX itself.
if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
elif [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

# GNU path prepends live in ~/.bashrc, which we always source below - it
# runs unconditionally there too (for non-login shells like tmux panes).
export PATH

# This bridge is optional and only runs when a local ~/.configure_tools.sh exists.
[[ -f "$HOME/dotfiles/home-config/configure_tools_bridge.bash" ]] && \
  source "$HOME/dotfiles/home-config/configure_tools_bridge.bash"

[[ -f "$HOME/.bashrc" ]] && source "$HOME/.bashrc"
