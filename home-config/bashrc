#!/usr/bin/env bash

################################################################
# LOCAL VARS
################################################################

DOTFILES=${HOME}/dotfiles
DOT_SETUP_FILE="${DOTFILES}/dot_setup.sh"

DOTBASE=${DOTFILES}/home-config
DOTSCRIPTS=${DOTFILES}/automation
DOTINSTALL=${DOTFILES}/installers
DOTRC=${DOTFILES}/shell-config

BASHRC_INTERACTIVE="${DOTFILES}/home-config/bashrc_interactive"

VIM=${HOME}/vim
TOOL_SCRIPTS="$HOME/dotfiles/bin"
BOB_NVIM="$HOME/.local/share/bob/nvim-bin"
GOBIN="/usr/local/go/bin"
SNAP="/snap/bin/hugo"

# wsl update keeps changing the the version prefix
if [[ "$(uname -s)" == "Linux" ]]; then
  PERF="$(echo /usr/lib/linux-tools/*-generic)"
else
  PERF=""
fi

################################################################
# ENV VARS (always: interactive and non-interactive shells)
################################################################

#export https_proxy=""
if command -v nvim >/dev/null 2>&1; then
  export EDITOR=nvim
  export VISUAL=nvim
elif command -v vim >/dev/null 2>&1; then
  export EDITOR=vim
  export VISUAL=vim
else
  export EDITOR=vi
  export VISUAL=vi
fi
export MYVIMRC="$HOME/.vimrc"
export XDG_CONFIG_HOME=${HOME}/.config
export INPUTRC="$HOME/.inputrc"
export COLUMNS

export CC=gcc
export CXX=g++

export GOPATH=${HOME}/go
export LOCALBIN=${HOME}/.local/bin
export LOCALNVIM=${HOME}/.local/nvim/bin

# required only if JAVA_HOME is not set by sdkman in the end of this script
# export JAVA_HOME=$(dirname $(dirname $(readlink -f $(which java))))
# export PATH=$JAVA_HOME/bin:$PATH

export DOTNET="$HOME/.dotnet"

# Prepend only directories that actually exist, skipping empty entries
# (an empty PATH segment means "search the current directory"). If the dir
# is already somewhere in PATH, strip it out first so it moves to the front
# instead of being a no-op (important for shells that inherit an
# already-built PATH, e.g. new tmux panes).
_dot_prepend_path() {
  [[ -d "$1" ]] || return 0
  if [[ ":$PATH:" == *:"$1":* ]]; then
    PATH=":$PATH:"          # pad with sentinels so the removal below can't match a substring of another entry
    PATH="${PATH//:$1:/:}"  # strip out every existing occurrence of the entry
    PATH="${PATH#:}"        # drop the leading sentinel
    PATH="${PATH%:}"        # drop the trailing sentinel
  fi
  PATH="$1:$PATH"
}

# Listed in reverse priority: each prepend wins over the ones before it,
# so BOB_NVIM ends up first and DOTNET last among these.
_dot_prepend_path "$DOTNET"
_dot_prepend_path "$PERF"
_dot_prepend_path "$GOBIN"
_dot_prepend_path "$LOCALNVIM"
_dot_prepend_path "$LOCALBIN"
_dot_prepend_path "$TOOL_SCRIPTS"
_dot_prepend_path "$GOPATH/bin"
_dot_prepend_path "$BOB_NVIM"

# On macOS, tmux panes (and other non-login shells) don't run bash_profile,
# so they never get the gnubin PATH prepends set up there. Redo them here
# (dedup-safe) so GNU tools always win, regardless of how the shell started.
if [[ "$(uname -s)" == "Darwin" ]]; then
  : "${HOMEBREW_PREFIX:=}"
  if [[ -z "$HOMEBREW_PREFIX" ]]; then
    if [[ -d /opt/homebrew ]]; then
      HOMEBREW_PREFIX=/opt/homebrew
    elif [[ -d /usr/local/Homebrew ]]; then
      HOMEBREW_PREFIX=/usr/local
    fi
  fi
  if [[ -n "$HOMEBREW_PREFIX" ]]; then
    _dot_prepend_path "$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin"
    _dot_prepend_path "$HOMEBREW_PREFIX/opt/findutils/libexec/gnubin"
    _dot_prepend_path "$HOMEBREW_PREFIX/opt/gnu-sed/libexec/gnubin"
    _dot_prepend_path "$HOMEBREW_PREFIX/opt/grep/libexec/gnubin"
    _dot_prepend_path "$HOMEBREW_PREFIX/opt/gnu-tar/libexec/gnubin"
  fi
  export HOMEBREW_PREFIX
fi
export PATH
# export MANPATH=$MANPATH:$HOME/share/man

## INSTALL MANAUAL BINARIES IN ~/thirdparty/*
for d in $HOME/thirdparty/*/; do
    [ -d "$d" ] && PATH+=":$d"
done

unset -f _dot_prepend_path

# rust env
[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

export NVM_DIR="$HOME/.config/nvm"

# Lazy-load nvm: sourcing nvm.sh resolves the default node version via 20-30+
# subprocess spawns (grep/sed/awk/node --version), adding roughly a second to
# every shell startup whether or not that shell ever touches node. Defer it
# until something nvm-related is actually used. Kept above the non-interactive
# guard below so non-interactive subprocesses (e.g. tools like Neovim spawn to
# check `node --version`) can resolve node too, not just interactive shells.
# - explicit stubs cover the common entry points directly.
# - command_not_found_handle catches anything else nvm put on PATH (yarn,
#   pnpm, tsc, ...) that isn't defined yet because nvm.sh hasn't run.
_dot_nvm_load() {
  unset -f nvm node npm npx command_not_found_handle _dot_nvm_load
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm()  { _dot_nvm_load; nvm "$@"; }
node() { _dot_nvm_load; node "$@"; }
npm()  { _dot_nvm_load; npm "$@"; }
npx()  { _dot_nvm_load; npx "$@"; }
command_not_found_handle() {
  _dot_nvm_load
  if command -v "$1" >/dev/null 2>&1; then
    "$@"
  else
    echo "bash: $1: command not found" >&2
    return 127
  fi
}

# Stop here for non-interactive shells.
[[ $- != *i* ]] && return

# Interactive-only setup.
[ -f "${BASHRC_INTERACTIVE}" ] && source "${BASHRC_INTERACTIVE}"

# coreutils gnubin is already added to PATH by bash_profile (via
# $HOMEBREW_PREFIX from `brew shellenv`, no extra brew subprocess needed).

export MONO_TLS_PROVIDER=legacy
export PATH="$HOME/.npm-global/bin:$PATH"
